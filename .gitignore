# Deploy — secrets files are committed AFTER sops encryption.
# *.dec files are local decrypted working copies — never commit these.
deploy/k8s/secrets/*.dec
deploy/secrets/*.dec
deploy/terraform/cloudflare/terraform.tfvars
deploy/terraform/cloudflare/terraform.tfstate
deploy/terraform/cloudflare/terraform.tfstate.backup
deploy/terraform/cloudflare/.terraform/
# bootstrap state/cache — same rules as cloudflare above (never commit tfstate or the
# provider cache). The canonical terraform SOURCE lives in shipyard/apps/truss/deploy;
# this dir is only leftover local state/cache from a past run.
deploy/terraform/bootstrap/terraform.tfstate
deploy/terraform/bootstrap/terraform.tfstate.backup
deploy/terraform/bootstrap/.terraform/
deploy/terraform/bootstrap/.terraform.lock.hcl
# .terraform.lock.hcl is intentionally committed where real tf SOURCE lives (not here)
